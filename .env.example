# НЕОБЯЗАТЕЛЬНЫЙ файл. Все настройки (сети, токены, UA, пути к sitemap, ключи, пороги) задаются в веб-интерфейсе:
#   python web.py  →  «Доступ» — и хранятся в БД; консольные скрипты читают те же значения.
# .env нужен только как запасной вариант: из него берётся то, что в интерфейсе не задано.
# Уже есть заполненный .env? Кнопка «Перенести из .env» на странице «Доступ» скопирует всё в БД.
# Дополнительные переменные для .env: NET_<КЛЮЧ>_SITEMAPS (пути карт, через запятую или с новой строки),
#   NET_<КЛЮЧ>_SITEMAPS_ROBOTS=1|0 (брать карты из robots.txt), NET_<КЛЮЧ>_SITEMAPS_FALLBACK=1|0 (пробовать /sitemap.xml).
#
# Скопируйте в .env и заполните. Проверяется ПРОД. Препрода и куки больше нет.
#
# ГДЕ ХРАНИТЬ: положите .env НА УРОВЕНЬ ВЫШЕ папки проекта (рядом с папкой проекта, не внутри неё).
# Так секреты не попадут в git, архив проекта и случайную отправку. Порядок поиска:
#   1) --env-file <путь>   2) переменная окружения TECHAUDIT_ENV   3) .env уровнем выше проекта
#   4) .env внутри проекта (запасной вариант). Переменные окружения процесса приоритетнее файла.

# ---------- Сети ----------
# Ключи латиницей. Для каждого ключа нужен файл registry/<ключ>.csv и переменная NET_<КЛЮЧ>_URL.
# URL — как сайт отдаётся «правильно» (схема + хост). Если основной хост с www — укажите с www:
# от этого зависят пробы «www / без www» и «http → https».
NETWORKS=net1,net2,net3

NET_5KA_URL=https://CHANGE-ME-net1
NET_NET2_URL=https://CHANGE-ME-net2
NET_NET3_URL=https://CHANGE-ME-net3

# ---------- Доступ (общий для всех скриптов) ----------
# Токен сайта ОБЯЗАТЕЛЕН: он обходит антифрод. У каждой сети свой токен — задавайте NET_<КЛЮЧ>_TOKEN.
# Токен сети отправляется только на хосты ЭТОЙ сети, в БД и логи не пишется.
NET_5KA_TOKEN=
NET_NET2_TOKEN=
NET_NET3_TOKEN=
# Имя заголовка с токеном (общее; если у сети другое — NET_<КЛЮЧ>_TOKEN_HEADER)
SP_TOKEN_HEADER=X-SP-Token
# NET_NET2_TOKEN_HEADER=X-Other-Token
# Запасной общий токен — только если токен у сетей один (скрипт предупредит). Лучше не использовать.
SP_TOKEN=
# 0 — только для диагностики (покажет, что отвечает сайт без токена)
USE_TOKEN=1

# User-Agent. UA_PROFILE — «поисковик»: с ним сервер отдаёт отрендеренную страницу
# (варианты bot и browser). PLAIN_UA_PROFILE — обычный клиент без рендеринга (вариант plain и пробы).
# Встроенные профили: googlebot, googlebot-mobile, yandexbot, desktop, mobile.
# Свои добавляются как UA_<ИМЯ>=строка.
UA_PROFILE=googlebot
PLAIN_UA_PROFILE=desktop
USE_UA=1
# UA_MYBOT=Mozilla/5.0 (compatible; MyBot/1.0)

# ---------- Внешние источники (необязательно) ----------
# Нет ключа — связанные проверки получают статус «пропущено», скрипт не падает.
PAGESPEED_API_KEY=
GSC_SERVICE_ACCOUNT_FILE=
YANDEX_WEBMASTER_TOKEN=
KEYSO_TOKEN=

# ---------- Прочее ----------
REQUEST_TIMEOUT=30
CONCURRENCY=4
RENDER_CONCURRENCY=2
# Пауза между стартами запросов, сек (бережно к проду)
REQUEST_DELAY=0.2
VERIFY_TLS=1
# Сколько URL каждого типа брать для проб (редиректы, 404)
PROBE_LIMIT=2
# Типы страниц, для которых не проверяем /index.php и /index.html
PROBE_INDEX_SKIP=product
# DATA_DIR=data
# REGISTRY_DIR=registry

# ---------- Проверки чек-листа (run_checks.py), всё необязательно ----------
# Чек-лист Excel (иначе ищется *тсх*.xlsx рядом с проектом)
# CHECKLIST_XLSX=техаудит_тсх_препрод.xlsx
# Порог TTFB, мс
TTFB_MAX_MS=600
# Контент без JS: минимум текста (симв.) и ссылок на странице
MIN_TEXT_CHARS=500
MIN_LINKS=10
# Доля картинок без alt: допуск / порог ошибки
ALT_WARN_SHARE=0.05
ALT_FAIL_SHARE=0.20
# Сколько URL брать на каждый вид живой выборки (--live)
LIVE_LIMIT=60
# Параметр пагинации
PAGINATION_PARAM=page
# og:image: минимальный размер
OG_MIN_WIDTH=600
OG_MIN_HEIGHT=315
# Старые/тестовые домены, которых не должно быть в canonical и разметке (через запятую)
# OLD_HOSTS=preprod.5ka.ru
# Типы страниц, где noindex — норма; роли для нестандартных типов; разводящие типы без товаров
# NOINDEX_TYPES=search,cart
# ROLE_OVERRIDES=my_listing:listing,my_card:product
# NAV_TYPES=catalog,cat_l1

# ---------- Дополнительные проверки и план работ, необязательно ----------
# Длина title и description (знаков); глубина страниц по краулу (кликов)
TITLE_MIN=10
TITLE_MAX=70
DESC_MIN=50
DESC_MAX=200
MAX_DEPTH=4
# Вес HTML (КБ), размер DOM (элементов), блокирующие скрипты в head
HTML_WARN_KB=500
HTML_FAIL_KB=1500
DOM_WARN=1500
DOM_FAIL=3000
BLOCKING_SCRIPTS_MAX=2
# TLS: предупреждать, если до конца сертификата меньше дней; HSTS: минимальный max-age, сек
CERT_MIN_DAYS=30
HSTS_MIN_AGE=15552000
# Дубли основного текста: доля совпадения (0-1)
DUP_TEXT_SIM=0.9
# План работ: доля часов для статуса «Требует внимания»; часы на каждую сеть отдельно (1); свой CSV check_id;role;hours;result
PLAN_WARN_SHARE=0.5
# PLAN_PER_NETWORK=1
# PLAN_FILE=plan_overrides.csv

# ---------- ИИ-этап (run_checks.py --ai), необязательно ----------
# OpenAI-совместимый API. Нет ключа — этап пропускается. ИИ не меняет статусы проверок, только пишет сводку и черновики.
AI_API_KEY=
AI_API_URL=https://api-copilot.x5.ru/v1
# x5-airun-medium — русский язык, контекст 65k; x5-airun-large — точнее, но медленнее (контекст 131k)
AI_MODEL=x5-airun-medium
# Лимит запросов за один запуск (повторы из кеша не считаются) и параллелизм (лимит модели medium — 8)
AI_MAX_REQUESTS=20
AI_TIMEOUT=180
AI_CONCURRENCY=2

